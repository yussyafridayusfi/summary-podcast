PORT=4000
DATABASE_URL=postgres://postgres@localhost:5432/podcast_summary

# --- AI summary generation -------------------------------------------------
# Set ONE of the following. The first key found wins, in this order:
#
#   1. Google Gemini  - free tier, get a key at https://aistudio.google.com/apikey
#   2. Groq           - free tier, get a key at https://console.groq.com/keys
#   3. Any OpenAI-compatible endpoint (set OPENAI_BASE_URL for non-OpenAI hosts)
#
# Illustrated images come from Pollinations, which needs no key at all.

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
