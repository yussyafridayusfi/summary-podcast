PORT=4000

# --- Storage --------------------------------------------------------------
# Postgres (default). Leave DATABASE_URL empty or set STORAGE=memory to run
# with an in-memory store (handy for demos; data resets on restart).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/podcast_summary
# STORAGE=memory

# --- Auth: verification emails ---------------------------------------------
# Passwordless sign-in: a 6-digit code is emailed. Without SMTP_HOST the code
# is printed in the backend log and (when NODE_ENV != production) returned to
# the browser as a dev hint, so the flow works with zero setup.
# APP_NAME=Summary Hub
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Summary Hub <no-reply@example.com>"

# --- AI: text (summaries) --------------------------------------------------
# All optional. With no keys the app falls back to Pollinations (no key,
# rate-limited to roughly 1 request / 15 s). Add ONE of these for a much
# better experience:
#   Groq       https://console.groq.com/keys         free, very fast, ~1k req/day
#   Gemini     https://aistudio.google.com/apikey    free, 1M-token context
#   Cerebras   https://cloud.cerebras.ai             free, 30 req/min
#   OpenRouter https://openrouter.ai/keys            free models, 50 req/day
# AI_TEXT_PROVIDER=auto        # auto | groq | gemini | cerebras | openrouter | pollinations
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free

# --- AI: images (share-card illustrations) ---------------------------------
# Pollinations works with no key. Register at https://auth.pollinations.ai
# for a free token that removes the logo and lifts the rate limit.
# AI_IMAGE_PROVIDER=auto       # auto | pollinations | huggingface | cloudflare
# POLLINATIONS_TOKEN=
# POLLINATIONS_IMAGE_MODEL=flux
# HF_TOKEN=                    # https://huggingface.co/settings/tokens  (FLUX.1-schnell)
# CF_ACCOUNT_ID=               # Cloudflare Workers AI: 10k free neurons/day
# CF_API_TOKEN=

# Used for OpenRouter attribution headers.
# APP_URL=http://localhost:5173
